# Copy into your existing .env.local. These are server-only settings.
# Leave enforcement off until a real provider adapter is connected and tested.
FACE_ATTENDANCE_REQUIRED=false
AADHAAR_ATTENDANCE_REQUIRED=false
IDENTITY_PROVIDER_URL=https://your-private-identity-adapter.example.com
IDENTITY_PROVIDER_API_KEY=
# Exact HTTPS origins allowed to host the provider's verification screens.
IDENTITY_HOSTED_ORIGINS=https://verify.your-provider.example.com
# Required before face processing can start. Publish actual contractual details.
FACE_PROVIDER_NAME=
FACE_RETENTION_NOTICE=
FACE_PRIVACY_CONTACT_EMAIL=
# Set a justified consent-evidence retention period, in days (1–3650).
FACE_CONSENT_RETENTION_DAYS=

# Direct AWS integration (no hosted gateway required for face checks).
# Keep FACE_ATTENDANCE_REQUIRED=false until sandbox and privacy acceptance pass.
FACE_VERIFICATION_PROVIDER=hosted
FACE_AWS_REGION=
FACE_AWS_ACCESS_KEY_ID=
FACE_AWS_SECRET_ACCESS_KEY=
FACE_AWS_SESSION_TOKEN=
FACE_AWS_BROWSER_ROLE_ARN=
FACE_AWS_LIVENESS_THRESHOLD=95
FACE_AWS_MATCH_THRESHOLD=99
# Set true only after AWS data-use opt-out, retention and region review.
FACE_AWS_DATA_USE_REVIEWED=false
